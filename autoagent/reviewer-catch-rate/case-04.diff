--- /dev/null
+++ b/scripts/test/cid-slug.bats
@@ -0,0 +1,16 @@
+#!/usr/bin/env bats
+# get_cid_slug — the slug a correlation ID carries.
+
+# shellcheck disable=SC2154  # BATS_TEST_DIRNAME is bats-provided
+
+setup() {
+  # shellcheck source-path=SCRIPTDIR source=../lib/cid-slug.sh
+  source "${BATS_TEST_DIRNAME}/../lib/cid-slug.sh"
+}
+
+@test "a title becomes a lowercase hyphenated slug of at most twenty characters" {
+  local title
+  for title in 'Auth Fix' 'Monitor cost ledger fix' '  --Wiki index: rebuild!'; do
+    run get_cid_slug "${title}"
+  done
+}
