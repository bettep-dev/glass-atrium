@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# run-project-check.sh — runs the check command declared under "check" in the project's .atrium.json.
+# Run from the project root: a directory without .atrium.json declares no check.
+set -Eeuo pipefail
+IFS=$'\n\t'
+trap 'printf "run-project-check: ERROR line %s: %s\n" "${LINENO}" "${BASH_COMMAND}" >&2' ERR
+
+readonly CONFIG_FILE='.atrium.json'
+
+main() {
+  [[ -r "${CONFIG_FILE}" ]] || return 0
+  local check_command
+  check_command="$(jq -r '.check // empty' "${CONFIG_FILE}")"
+  [[ -n "${check_command}" ]] || return 0
+  eval "${check_command}"
+}
+
+main "$@"
