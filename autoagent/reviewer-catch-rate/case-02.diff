@@ -0,0 +1,9 @@
+const FALLBACK_PATH = "/";
+
+/** Redirect path for the `next` query value; a value that is not a same-site path falls back to the dashboard root. */
+export function getRedirectTarget(next: string | undefined): string {
+  if (next === undefined || !next.startsWith("/")) {
+    return FALLBACK_PATH;
+  }
+  return next;
+}
